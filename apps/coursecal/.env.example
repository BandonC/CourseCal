# Copy to .env.local in this directory and fill in. Never commit .env.local.
# Values come from the provider consoles (Neon, Google Cloud, Anthropic) and locally
# generated secrets (AUTH_SECRET, TOKEN_ENCRYPTION_KEY).

# Neon Postgres — pooled for runtime
DATABASE_URL=
# Neon Postgres — direct, migrations only (never referenced in app code)
DIRECT_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Google Cloud console → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
# Optional: pin a specific model identifier (verify against current Anthropic docs)
# ANTHROPIC_MODEL=

# Refresh-token encryption key (AES-256-GCM) — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Observability — optional until launch
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog cloud region for ingestion. Optional — defaults to US when unset.
# US: https://us.i.posthog.com   EU: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source-map upload — BUILD-TIME ONLY, optional (set in Vercel Production,
# not needed for local dev). Without it errors still report, but prod stack traces
# stay minified. org/project are configured in next.config.ts; create the token in
# Sentry → Settings → Auth Tokens (scopes: project:releases, org:read, project:write).
# SENTRY_AUTH_TOKEN=
