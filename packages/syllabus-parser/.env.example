# Copy to .env in this directory and fill in. Never commit .env.
# The library is developed and tested standalone (Phase 1) before the app exists,
# and Next.js only loads env from the app dir — so the library carries its own
# env, loaded via dotenv in its test/eval scripts. See DECISIONS.md (2026-06-12).

# Anthropic
ANTHROPIC_API_KEY=
# Optional: pin a specific model identifier (verify against current Anthropic docs)
# ANTHROPIC_MODEL=
